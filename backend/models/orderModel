const mongoose = require("mongoose");

const orderSchema = new mongoose.Schema(
  {
    items: {
      type: Array,
      required: true,
    },
    totalAmount: {
      type: Number,
      required: true,
    },
    userEmail: {
      type: String,
      required: true,
    },
    orderType: {
      type: String,
      enum: ["regular", "customCake"],
      default: "regular",
    },
    customCake: {
      cakeType: String,
      flavor: String,
      size: String,
      shape: String,
      message: String,
      deliveryDate: String,
    },
    status: {
      type: String,
      default: "Pending",
    },
  },
  { timestamps: true }
);

module.exports = mongoose.model("Order", orderSchema);
